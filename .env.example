# Copy to .env and fill in. Every value is optional unless noted.

# --- Director LLM --------------------------------------------------------
# Which LLM directs the music: none | claude | local | jevtypesafe
# ("none" = deterministic director; it still sounds good without an LLM)
YS_LLM=local
# Optional model override for the chosen provider (empty = provider default)
YS_LLM_MODEL=
YS_LLM_TIMEOUT=60
# Seconds to wait at startup for the local model to finish loading
YS_LLM_LOAD_TIMEOUT=300

# Claude (Anthropic API). Default model: claude-opus-5
ANTHROPIC_API_KEY=
YS_CLAUDE_MODEL=claude-opus-5
# Optional: low | medium | high | xhigh | max (empty = API default, high)
YS_CLAUDE_EFFORT=

# Local llama.cpp server (OpenAI-compatible)
YS_LOCAL_MODEL=qwen-agentworld-35b
LLAMA_SERVER_BIN=/path/to/llama.cpp/build/bin/llama-server
LLAMA_GGUF_MODEL=/path/to/model.gguf
LOCAL_LLM_API_BASE=http://127.0.0.1:8080/v1

# jevtypesafeai.com: see https://jevtypesafeai.com/how-to-use for these values
YS_JEV_API_BASE=
YS_JEV_API_KEY=
YS_JEV_MODEL=default
# "openai" = OpenAI-compatible /chat/completions under YS_JEV_API_BASE
# "json"   = POST {"model","system","prompt","max_tokens"} to YS_JEV_API_BASE,
#            reply {"text": ...} (also accepts "output"/"response"/"content")
YS_JEV_API_STYLE=openai

# Style and mood (same as --style / --theme; used by the systemd service too)
# YS_STYLE: lofi | ambient | downtempo | piano, empty = rotate between styles
YS_STYLE=
# YS_THEME: free-text brief for the LLM Director (no quotes needed)
YS_THEME=chill music to relax, study and sleep to

# --- Narration (spoken Director lines) -------------------------------------
# sections = speak at every section change, pieces = only when a piece starts, off
YS_NARRATION=sections
# Piper voice model (.onnx); install.sh downloads the default into voices/
YS_TTS_VOICE=voices/en_GB-jenny_dioco-medium.onnx
# warm = low, intimate late-night radio voice; calm = clean and soft
YS_VOICE_STYLE=warm
# Speech speed: higher = slower (warm default 1.25)
YS_TTS_LENGTH_SCALE=1.25
# Voice loudness in dB relative to Piper's output, and how much the music dips
# while it speaks (gain factor; 0.9 is about -3.5 dB, 1.0 = no dip)
YS_NARRATION_VOLUME_DB=0
YS_NARRATION_DUCK=0.9
# Minimum seconds between spoken section lines (piece intros always speak)
YS_NARRATION_MIN_GAP=60

# Extra orchestrator flags used by the systemd engine unit (no spaces inside values)
YS_ENGINE_ARGS=--free-layer

# --- Audio ----------------------------------------------------------------
# Route SuperCollider straight into the stream sink (created by stream/setup_audio.sh)
YS_JACK_OUTPUTS=ystream_sink:playback_FL,ystream_sink:playback_FR
YS_SINK_NAME=ystream_sink
YS_AUDIO_SOURCE=ystream_sink.monitor
# "pw-jack" on PipeWire systems; empty on a real JACK server
YS_SCLANG_PREFIX=pw-jack

# --- Stream ---------------------------------------------------------------
# REQUIRED for streaming: YouTube Studio -> Go live -> Stream key
YT_STREAM_KEY=
# Background: image (png/jpg/webp), animated gif, or video (mp4/mov/webm/mkv,
# looped, its sound ignored). Empty = dark colour. Scaled to fill, centre-cropped.
YS_STREAM_BG=
# Darken the background so the text stays readable (0 = off, 1 = black)
YS_BG_DIM=0.35
# Blur the background (pixels, 0 = off), e.g. 8 for a soft, out-of-focus look
YS_BG_BLUR=0
YS_VIDEO_SIZE=1280x720
YS_FPS=30
YS_VIDEO_BITRATE=3000k
YS_STREAM_SEGMENT_HOURS=11

# --- Ops ------------------------------------------------------------------
# Push notifications on restarts / quality alerts, e.g. https://ntfy.sh/my-secret-topic
YS_NTFY_URL=
YS_SILENCE_SECONDS=20
YS_HEARTBEAT_LIMIT=180
YS_RESTART_CMD=systemctl --user restart ystreamer-engine.service
YS_MAX_ACTIVE_LAYERS=6
