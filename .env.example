# Copy to .env and fill in. Every value is optional unless noted.

# --- Director LLM --------------------------------------------------------
# Empty = deterministic director (still sounds good, no LLM needed).
YS_DIRECTOR_MODEL=local/qwen-agentworld-35b
LLAMA_SERVER_BIN=/path/to/llama.cpp/build/bin/llama-server
LLAMA_GGUF_MODEL=/path/to/model.gguf
LOCAL_LLM_API_BASE=http://127.0.0.1:8080/v1
YS_LLM_TIMEOUT=60
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...

# Extra orchestrator flags used by the systemd engine unit
YS_ENGINE_ARGS=--director-model local/qwen-agentworld-35b --free-layer

# --- Audio ----------------------------------------------------------------
# Route SuperCollider straight into the stream sink (created by stream/setup_audio.sh)
YS_JACK_OUTPUTS=ystream_sink:playback_FL,ystream_sink:playback_FR
YS_SINK_NAME=ystream_sink
YS_AUDIO_SOURCE=ystream_sink.monitor
# "pw-jack" on PipeWire systems; empty on a real JACK server
YS_SCLANG_PREFIX=pw-jack

# --- Stream ---------------------------------------------------------------
# REQUIRED for streaming: YouTube Studio -> Go live -> Stream key
YT_STREAM_KEY=
# Background image (.png/.jpg) or looping video (.mp4); empty = dark colour
YS_STREAM_BG=
YS_VIDEO_SIZE=1280x720
YS_FPS=30
YS_VIDEO_BITRATE=3000k
YS_STREAM_SEGMENT_HOURS=11

# --- Ops ------------------------------------------------------------------
# Push notifications on restarts / quality alerts, e.g. https://ntfy.sh/my-secret-topic
YS_NTFY_URL=
YS_SILENCE_SECONDS=20
YS_HEARTBEAT_LIMIT=180
YS_RESTART_CMD=systemctl --user restart ystreamer-engine.service
YS_MAX_ACTIVE_LAYERS=6
