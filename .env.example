# Copy to .env and fill in. Every value is optional unless noted.

# --- Director LLM --------------------------------------------------------
# Which LLM directs the music: none | claude | local | jevtypesafe
# ("none" = deterministic director; it still sounds good without an LLM)
YS_LLM=local
# Optional model override for the chosen provider (empty = provider default)
YS_LLM_MODEL=
YS_LLM_TIMEOUT=60
# The local model: seconds per call, and how long the Performer waits for an
# edit (a late edit comes in on the next bar; the music keeps playing).
YS_LOCAL_LLM_TIMEOUT=180
YS_LOCAL_PERFORMER_WAIT=60
# Bars between edits while a track builds up (then the style's interval)
YS_BUILD_BARS=4
# Seconds to wait at startup for the local model to finish loading
YS_LLM_LOAD_TIMEOUT=300

# Claude (Anthropic API). Default model: claude-opus-5
ANTHROPIC_API_KEY=
# Only for a key not scoped to a workspace (API error 400 "anthropic-workspace-id"):
# the workspace's ID from the Console (Settings > Workspaces), wrkspc_...
ANTHROPIC_WORKSPACE_ID=
YS_CLAUDE_MODEL=claude-opus-5
# Optional: low | medium | high | xhigh | max (empty = API default, high)
YS_CLAUDE_EFFORT=

# Local llama.cpp server (OpenAI-compatible)
YS_LOCAL_MODEL=qwen-agentworld-35b
LLAMA_SERVER_BIN=/path/to/llama.cpp/build/bin/llama-server
LLAMA_GGUF_MODEL=/path/to/model.gguf
# Context shared by 2 parallel slots (the performer needs ~5k). Lower it if
# llama-server fails with "failed to allocate buffer for kv cache".
LLAMA_CTX_SIZE=16384
# Layers on the GPU (999 = all); lower if the weights don't fit.
LLAMA_GPU_LAYERS=999            # or "auto": llama.cpp fits what it can on the GPUs, the rest in RAM
# Extra llama-server flags, e.g. a smaller KV cache and flash attention:
# LLAMA_SERVER_ARGS=-fa on --cache-type-k q8_0 --cache-type-v q8_0
LOCAL_LLM_API_BASE=http://127.0.0.1:8080/v1

# jevtypesafeai.com (--llm jevtypesafe). Its decision API picks each live edit
# from a list of legal candidates. Only the key is needed:
YS_JEV_API_KEY=
# YS_JEV_API_BASE=https://jevtypesafeai.com/api/v1/decide   (the default)
# YS_JEV_API_STYLE=decide   ("openai"/"json" only for a text-completion endpoint)

# Style and mood (same as --style / --theme)
# YS_STYLE: lofi | ambient | downtempo | piano, empty = rotate between styles
YS_STYLE=
# YS_THEME: free-text brief for the LLM Director (no quotes needed)
YS_THEME=chill music to relax, study and sleep to

# --- Narration (spoken Director lines) -------------------------------------
# sections = speak at every section change, pieces = only when a piece starts, off
YS_NARRATION=sections
# Piper voice model (.onnx); install.sh downloads the default into voices/
YS_TTS_VOICE=voices/en_GB-jenny_dioco-medium.onnx
# warm = low, intimate late-night radio voice; calm = clean and soft
YS_VOICE_STYLE=warm
# Speech speed: higher = slower (warm default 1.25)
YS_TTS_LENGTH_SCALE=1.25
# Voice level in dB above the stream loudness (-14 LUFS), and how much the
# music dips while it speaks (gain factor; 0.85 is about -5.6 dB, 1.0 = no dip)
YS_NARRATION_VOLUME_DB=2
YS_NARRATION_DUCK=0.85
# Minimum seconds between spoken section lines (piece intros always speak)
YS_NARRATION_MIN_GAP=60


# --- Audio ----------------------------------------------------------------
# Route SuperCollider straight into the stream sink (created by stream/setup_audio.sh)
YS_JACK_OUTPUTS=ystream_sink:playback_FL,ystream_sink:playback_FR
YS_SINK_NAME=ystream_sink
YS_AUDIO_SOURCE=ystream_sink.monitor
# "pw-jack" on PipeWire systems; empty on a real JACK server
YS_SCLANG_PREFIX=pw-jack

# --- Stream ---------------------------------------------------------------
# REQUIRED for streaming: YouTube Studio -> Go live -> Stream key
# The saws done properly (supersaw chords and lead, saw lead, saw pad bed):
# listen first with `python -m eval.sound_preview` and `--saws`
# (recordings/preview/), then set 1.
YS_HYPERSAW=0
# The art director's surprises (music/surprises.py): at most one every N tracks.
YS_SURPRISE_EVERY=2
# Explore or exploit (music/explore.py): the base chance a track explores (the
# least-tried touchstone, spark, mode and tempo, bold choices) rather than build
# on what earned thumbs. Rises after a 👎, falls after a 👍. 0-1.
YS_EXPLORE=0.5
# Licensed acapellas (acapellas/acapellas.json, then `python -m music.vocals`):
# the share of tracks that sing one when one fits (0 = never, 1 = always).
YS_ACAPELLA_CHANCE=0.5
# The channel name shown on the stream page, the poster and the channel art.
YS_CHANNEL_NAME=InfiniTrance
YT_STREAM_KEY=
# Background: image (png/jpg/webp), animated gif, or video (mp4/mov/webm/mkv,
# looped, its sound ignored). Empty = dark colour. Scaled to fill, centre-cropped.
YS_STREAM_BG=
# Darken the background so the text stays readable (0 = off, 1 = black)
YS_BG_DIM=0.35
# Blur the background (pixels, 0 = off), e.g. 8 for a soft, out-of-focus look
YS_BG_BLUR=0
YS_VIDEO_SIZE=1280x720
YS_FPS=30
YS_VIDEO_BITRATE=3000k
YS_STREAM_SEGMENT_HOURS=11

# --- Ops ------------------------------------------------------------------
# Push notifications on restarts / quality alerts, e.g. https://ntfy.sh/my-secret-topic
YS_NTFY_URL=
YS_SILENCE_SECONDS=20
YS_HEARTBEAT_LIMIT=180
# How the watchdog restarts the engine. Empty (default): stop the engine
# process and let stream/live.sh start it again with --resume.
YS_RESTART_CMD=
YS_MAX_ACTIVE_LAYERS=6

# Freesound API key (freesound.org/apiv2/apply): `python -m music.instruments`
# fetches the CC0 voices with it (femalevox, voxchop, crowdchoir).
FREESOUND_CLIENT_ID=
FREESOUND_API_KEY=
