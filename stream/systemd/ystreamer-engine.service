[Unit]
Description=ystreamer: SuperDirt + Tidal + live-coding engine (local LLM performs, jevtypesafe judges; resumes the saved track)
After=ystreamer-audio.service ystreamer-llm.service
Requires=ystreamer-audio.service

[Service]
WorkingDirectory=@REPO@
EnvironmentFile=@REPO@/.env
# Streaming default: the local model performs, jevtypesafe judges its ideas.
# YS_ENGINE_ARGS in .env comes last, so it can override these (e.g.
# "--llm claude --model claude-haiku-4-5" or "--judge none").
ExecStart=@PYTHON@ @REPO@/orchestrator.py --resume --llm local --judge jevtypesafe $YS_ENGINE_ARGS
Restart=always
RestartSec=5
# SuperCollider's scsynth is a child of sclang; make sure it dies with us.
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=default.target
