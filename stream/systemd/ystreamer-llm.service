[Unit]
Description=ystreamer: local llama.cpp server for the Director
After=network.target

[Service]
EnvironmentFile=@REPO@/.env
ExecStart=/bin/sh -c 'exec "$LLAMA_SERVER_BIN" -m "$LLAMA_GGUF_MODEL" -ngl 999 --port 8080 --ctx-size 16384 --parallel 2'
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
